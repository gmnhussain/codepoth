# Copy to .env.local for local work. Never commit .env.local.

# Include draft lessons and glossary entries ("1") or leave them out ("0", the
# default). Set to 1 only for local and preview builds; production leaves it
# unset so drafts never reach readers (ADR-0009, docs/content-model.md#drafts).
# A build with VERCEL_ENV=production refuses CONTENT_INCLUDE_DRAFTS=1.
CONTENT_INCLUDE_DRAFTS=0

# VERCEL_ENV is set by Vercel (production | preview | development); do not set
# it yourself. The content layer reads it only for the guard above.
