{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    // scripts/ run directly with Node, which needs the `.ts` in their
    // relative imports (ADR-0015); nothing is emitted (noEmit).
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
