{
  "name": "@workspace/content",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "content:generate": "content-collections build",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@content-collections/core": "catalog:",
    "@mdx-js/mdx": "catalog:",
    "@workspace/config": "workspace:*",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-pretty-code": "^0.14.6",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "unist-util-visit": "^5.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@content-collections/cli": "^0.1.9",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    "./content": "./src/content.ts",
    "./graph": "./src/graph.ts",
    "./paths": "./src/paths.ts",
    "./schemas/*": "./src/schemas/*.schema.ts",
    "./generated": {
      "types": "./.content-collections/generated/index.d.ts",
      "default": "./.content-collections/generated/index.js"
    }
  }
}
