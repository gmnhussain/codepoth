{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["CI", "E2E_MATRIX", "npm_execpath"],
  "tasks": {
    "content:generate": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/**"],
      "outputs": [".content-collections/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^content:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/content/**"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "public/pagefind/**"
      ],
      "env": [
        "CONTENT_INCLUDE_DRAFTS",
        "VERCEL_ENV",
        "VERCEL",
        "NEXT_ADAPTER_PATH"
      ]
    },
    "lint": {
      "dependsOn": ["^lint", "^content:generate", "content:generate"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^content:generate", "content:generate"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test", "^content:generate", "content:generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/content/**",
        "$TURBO_ROOT$/packages/ui/src/styles/globals.css"
      ],
      "outputs": [],
      "env": ["CONTENT_INCLUDE_DRAFTS", "VERCEL_ENV"]
    }
  }
}
